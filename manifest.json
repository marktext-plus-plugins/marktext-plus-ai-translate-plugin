  "settings": [
    {
      "key": "writingSystem",
      "title": "settings.writingSystem",
      "type": "text",
      "default": "You rewrite Markdown to a brief the reader gives you.\n\nRules:\n- Follow the brief. It is the whole of what was asked for.\n- Preserve every Markdown construct: headings, lists, tables, links,\n  images, footnotes, block quotes and front matter.\n- Do not touch code inside fences or inline code, URLs or file paths.\n- Write in the language the text is already in, unless told otherwise.\n- Return only the rewritten Markdown: no preamble, no explanation, and no\n  fence wrapped around the whole answer."
    },
    {
      "key": "writingUser",
      "title": "settings.writingUser",
      "type": "text",
      "default": "Brief: {{instruction}}\n\nText:\n{{text}}"
    },
    {
      "key": "proofreadingSystem",
      "title": "settings.proofreadingSystem",
      "type": "text",
      "default": "You correct Markdown: spelling, typing slips, grammar and punctuation.\n\nRules:\n- Correct mistakes. Do not rewrite anything that is merely not how you\n  would have put it — the voice is the author's.\n- Preserve every Markdown construct, and the block order.\n- Do not touch code inside fences or inline code, URLs or file paths.\n- Keep the language the text is written in.\n- Return only the corrected Markdown: no preamble, no list of what you\n  changed, and no fence wrapped around the whole answer."
    },
    {
      "key": "proofreadingUser",
      "title": "settings.proofreadingUser",
      "type": "text",
      "default": "Text:\n{{text}}"
    },
    {
      "key": "translationSystem",
      "title": "settings.translationSystem",
      "type": "text",
      "default": "You translate Markdown into {{language}}.\n\nRules:\n- Preserve every Markdown construct exactly: headings, lists, tables,\n  links, images, footnotes, block quotes and front matter.\n- Do not translate code inside fences or inline code, URLs, file paths,\n  or HTML tag names.\n- Keep the same block order and the same number of blocks.\n- Return only the translated Markdown, with no preamble and no fence\n  wrapped around the whole answer."
    },
    {
      "key": "translationUser",
      "title": "settings.translationUser",
      "type": "text",
      "default": "Document:\n{{text}}"
    }
  ],
  "menus": [
    {
      "id": "ai.write",
      "title": "menu.write",
      "location": "editor.contextMenu"
    },
    {
      "id": "ai.proofread",
      "title": "menu.proofread",
      "location": "editor.contextMenu"
    },
    {
      "id": "translate.selection",
      "title": "menu.selection",
      "location": "editor.contextMenu",
      "when": "selection"
    },
    {
      "id": "translate.document",
      "title": "menu.document",
      "location": "editor.contextMenu",
      "when": "noSelection"
    }
  ],
  "panels": [
    {
      "id": "ai.write",
      "title": "menu.write",
      "icon": "edit_note"
    }
  ]
}
