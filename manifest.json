{
  "id": "com.marktextplus.ai-translate",
  "name": "AI Translate",
  "version": "1.0.0",
  "runtime": "lua",
  "entrypoint": "plugin.lua",
  "minAppVersion": "1.6.1",
  "repository": "https://github.com/marktext-plus-plugins/marktext-plus-ai-translate-plugin",
  "permissions": [
    "document.read",
    "ai.chat",
    "storage.local",
    "ui.contextMenu",
    "ui.settings",
    "ui.notifications"
  ],
  "defaultLocale": "en",
  "locales": {
    "en": {
      "menu.selection": "Translate selection",
      "menu.document": "Translate document",
      "ask.language": "Target language",
      "error.empty": "Select some text first, or use Translate document",
      "settings.target": "Default target language"
    },
    "zh": {
      "menu.selection": "翻译选中内容",
      "menu.document": "翻译全文",
      "ask.language": "目标语言",
      "error.empty": "请先选中文本，或使用“翻译全文”",
      "settings.target": "默认目标语言"
    },
    "ja": {
      "menu.selection": "選択範囲を翻訳",
      "menu.document": "ドキュメントを翻訳",
      "ask.language": "翻訳先の言語",
      "error.empty": "先にテキストを選択するか、ドキュメント全体を翻訳してください",
      "settings.target": "既定の翻訳先言語"
    },
    "de": {
      "menu.selection": "Auswahl übersetzen",
      "menu.document": "Dokument übersetzen",
      "ask.language": "Zielsprache",
      "error.empty": "Markieren Sie zuerst Text, oder übersetzen Sie das ganze Dokument",
      "settings.target": "Standard-Zielsprache"
    },
    "fr": {
      "menu.selection": "Traduire la sélection",
      "menu.document": "Traduire le document",
      "ask.language": "Langue cible",
      "error.empty": "Sélectionnez d’abord du texte, ou traduisez tout le document",
      "settings.target": "Langue cible par défaut"
    }
  },
  "settings": [
    {
      "key": "targetLanguage",
      "title": "settings.target",
      "type": "text",
      "default": "English"
    }
  ],
  "menus": [
    {
      "id": "translate.selection",
      "title": "menu.selection",
      "location": "editor.contextMenu",
      "when": "selection"
    },
    {
      "id": "translate.document",
      "title": "menu.document",
      "location": "editor.contextMenu",
      "when": "noSelection"
    }
  ]
}
